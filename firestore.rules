rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data for write operations
    // But allow public read access for user pages
    match /users/{userId} {
      // Allow public read access to user profiles (for user pages)
      allow read: if true;
      // Allow users to write only their own profile
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Allow public read access to products (for user pages)
      // Allow users to write only their own products
      match /products/{productId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Allow public read access to dashboard data (for user pages)
      // Allow users to write only their own dashboard data
      match /dashboard/{document} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
      
      // PayPal transactions - private data, only accessible by the user
      match /paypal_transactions/{transactionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // User's vendors subcollection - private to each user
      match /vendors/{vendorId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // User's payment methods subcollection - private to each user
      match /paymentMethods/{paymentMethodId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Push notification subscriptions - private to each user
      match /pushSubscriptions/{subscriptionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Connected Gmail accounts (one doc per linked inbox). Created by the
      // OAuth callback and removed by the disconnect endpoint (both Admin
      // SDK, which bypasses these rules). The only field a client may write
      // directly is `retailers` (checkbox toggles) — everything else
      // (connected/email/timestamps) stays server-only.
      match /gmailAccounts/{accountId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retailers']);
        allow create, delete: if false;

        // OAuth refresh token — never client-readable, at any uid.
        match /secret/{secretId} {
          allow read, write: if false;
        }
      }

      // User-configurable notification preferences (e.g. return-reminder
      // days) — plain preferences, no secrets, so the owner can read/write
      // directly.
      match /settings/{settingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Draft products detected from Gmail order-confirmation emails,
      // pending the user's review. Created only by the Admin SDK (bypasses
      // rules); the client can read them to show the review list and delete
      // them once added or dismissed.
      match /pendingGmailImports/{importId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false;
      }

      // Draft PayPal transactions detected from Gmail, pending the user's
      // review — same access shape as pendingGmailImports above.
      match /pendingGmailTransactionImports/{importId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if false;
      }
    }
  }
}
